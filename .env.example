APP_NAME=OrientMaps
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
VERIFY_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false

DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/orientmaps

FIRST_ADMIN_LOGIN=admin
FIRST_ADMIN_EMAIL=car_specific@mail.ru
FIRST_ADMIN_PASSWORD=change-me

OMAPS_SPB_LOGIN=o-maps.spb.ru
OMAPS_SPB_PASSWORD=change-me
OMAPS_MOSCOW_LOGIN=o-maps.moscow.ru
OMAPS_MOSCOW_PASSWORD=change-me

MAX_UPLOAD_BYTES=52428800
PARSER_MIN_YEAR=2020

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_MAX_POST_REQUESTS=25
RATE_LIMIT_BLOCK_SECONDS=300

# Yandex Mail (на Yandex Cloud SMTP работает)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@o-maps.net.ru
SMTP_PASSWORD=
SMTP_SENDER=noreply@o-maps.net.ru
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=20

USE_S3=true
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=orientmaps-archive
S3_REGION=ru-central1
S3_PUBLIC_BASE_URL=https://storage.yandexcloud.net/orientmaps-archive

EXPOSE_LOCAL_MEDIA=false

LOCAL_UPLOAD_DIR=uploads
SITE_BACKGROUND_URL=https://storage.yandexcloud.net/orientmaps-archive/ui/site-background.jpg
DEFAULT_AVATAR_URL=https://i.pinimg.com/736x/bf/3a/5b/bf3a5beed53640cb39c307219a7d1837.jpg
