@startuml use_case_diagram
' Диаграмма вариантов использования OrientMaps.Net
' Отрисовка: https://www.plantuml.com/plantuml/uml/

skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 11
}
skinparam actor {
  FontSize 12
}

left to right direction

actor "Гость" as Guest
actor "Пользователь" as User
actor "Администратор" as Admin
actor "o-maps.spb.ru\n(внешний источник)" as OMaps

Admin --|> User
User --|> Guest

rectangle "Система OrientMaps.Net" {

  package "Аутентификация и регистрация" {
    usecase "UC1\nРегистрация\nучётной записи" as UC1
    usecase "UC2\nВход в систему\n(JWT-cookie)" as UC2
    usecase "UC3\nВыход\nиз системы" as UC3
  }

  package "Просмотр и поиск" {
    usecase "UC4\nПросмотр ленты\nкарт" as UC4
    usecase "UC5\nПоиск, фильтрация\nи сортировка\nв каталоге" as UC5
    usecase "UC6\nПросмотр страницы\nкарты" as UC6
    usecase "UC7\nСкачивание\nизображения карты" as UC7
  }

  package "Работа с картами" {
    usecase "UC8\nДобавление карты\nпользователем" as UC8
    usecase "UC9\nРедактирование\nкарты" as UC9
    usecase "UC10\nУдаление карты" as UC10
    usecase "UC11\nКомментирование\nкарты" as UC11
    usecase "UC12\nЛайк карты" as UC12
  }

  package "Профиль" {
    usecase "UC13\nПросмотр профиля\nпользователя" as UC13
    usecase "UC14\nРедактирование\nпрофиля и аватара" as UC14
  }

  package "Импорт и модерация" {
    usecase "UC15\nИмпорт карт\nиз O-Maps\n(парсинг JS-фидов)" as UC15
    usecase "UC16\nРедактирование\nметаданных\nв очереди" as UC16
    usecase "UC17\nПубликация\nимпортированной карты" as UC17
    usecase "UC18\nУдаление карты\nиз очереди / архива" as UC18
  }
}

Guest --> UC2
Guest --> UC1
Guest --> UC4
Guest --> UC5
Guest --> UC6
Guest --> UC7
Guest --> UC13

User --> UC3
User --> UC8
User --> UC9
User --> UC10
User --> UC11
User --> UC12
User --> UC14

Admin --> UC9
Admin --> UC10
Admin --> UC15
Admin --> UC16
Admin --> UC17
Admin --> UC18

UC15 --> OMaps : <<получение\nданных>>
UC15 ..> UC16 : <<include>>
UC16 ..> UC17 : <<extend>>
UC16 ..> UC18 : <<extend>>

@enduml
